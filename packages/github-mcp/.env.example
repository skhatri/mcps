# GitHub Authentication Token
# 
# Option 1: Personal Access Token (PAT)
# Create at: https://github.com/settings/tokens
# Required permissions: repo, pull_requests:write
# GITHUB_TOKEN=ghp_your_personal_access_token_here
#
# Option 2: GitHub App Installation Token  
# Create a GitHub App and install it to your repositories
# Required permissions: Contents: Read, Pull requests: Write, Metadata: Read
# GITHUB_TOKEN=ghs_your_installation_token_here
#
# Both token types work automatically - no configuration needed
GITHUB_TOKEN=your_github_token_here