{
  "name": "@skhatri/mcps",
  "version": "0.5.0",
  "description": "Multi-module MCP (Model Context Protocol) packages collection",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces",
    "publish-all": "npm publish --workspaces",
    "version-patch": "npm version patch --workspaces",
    "version-minor": "npm version minor --workspaces",
    "version-major": "npm version major --workspaces",
    "sync-versions": "node scripts/sync-versions.js",
    "set-version": "node scripts/sync-versions.js",
    "version-bump-patch": "npm version patch && npm run sync-versions",
    "version-bump-minor": "npm version minor && npm run sync-versions",
    "version-bump-major": "npm version major && npm run sync-versions"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skhatri/mcps.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "tools"
  ],
  "author": "skhatri",
  "license": "MIT",
  "dependencies": {
    "crudjson": "^0.0.2"
  }
}
